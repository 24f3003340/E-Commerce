# ── Server ──
PORT=4000
NODE_ENV=development
# Comma separated list of allowed origins (customer website, admin panel)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_API_URL=http://localhost:4000

# ── Database / cache ──
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public
# Optional. When empty an in-memory cache is used.
REDIS_URL=redis://localhost:6379

# ── Auth ── (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ADMIN_ACCESS_SECRET=change-me-admin-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Payments (Razorpay) ──
# Leave empty in development to use the built-in MOCK gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Shipping aggregator webhook (Shiprocket etc.) ──
SHIPPING_WEBHOOK_TOKEN=change-me-shipping-token

# ── Email (Resend). Empty = emails are logged to the console ──
RESEND_API_KEY=
EMAIL_FROM=Store <orders@example.com>

# ── Seed ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
