# ── Server ──
PORT=4000
NODE_ENV=development
# Comma separated list of allowed origins (customer website, admin panel)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_API_URL=http://localhost:4000
# Customer website (links in emails: password reset, order pages)
STOREFRONT_URL=http://localhost:3000
# Admin app — the marketplace seller panel lives at <ADMIN_URL>/seller (links in seller emails)
ADMIN_URL=http://localhost:3001

# ── Database / cache ──
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public
# Optional. When empty an in-memory cache is used.
REDIS_URL=redis://localhost:6379

# ── Auth ── (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ADMIN_ACCESS_SECRET=change-me-admin-access-secret
# Optional; marketplace seller panel tokens (derived from JWT_ACCESS_SECRET when empty)
JWT_SELLER_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Payments (Razorpay) ──
# Leave empty in development to use the built-in MOCK gateway. In production, checkout is cash on
# delivery only ("Pay online — coming soon") until these keys are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Shipping aggregator webhook (Shiprocket etc.) ──
SHIPPING_WEBHOOK_TOKEN=change-me-shipping-token
# ── Shiprocket courier booking (empty = enter courier AWBs by hand) ──
# API user from Shiprocket → Settings → API → Configure (not your main login)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup address nickname for the store's own orders (Shiprocket → Settings → Pickup addresses)
SHIPROCKET_PICKUP_LOCATION=Primary
# Token Shiprocket sends (x-api-key) with tracking webhooks to POST /shipping/courier-updates
SHIPROCKET_WEBHOOK_TOKEN=

# ── Image storage (Cloudflare R2 / AWS S3 / DO Spaces). Empty = local disk (dev only) ──
# R2 example: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket (R2 public bucket URL or your CDN domain)
S3_PUBLIC_URL=

# ── Email (Resend). Empty = emails are logged to the console ──
RESEND_API_KEY=
EMAIL_FROM=Store <orders@example.com>

# ── Seed ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345

