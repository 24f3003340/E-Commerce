# Used by server components (inside Docker this can be the internal service URL)
API_URL=http://localhost:4000
# Used by the browser
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STORE_NAME=StyleKart
# Public website URL (canonical links, sitemap.xml, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Admin app URL — the footer links to its seller panel (<NEXT_PUBLIC_ADMIN_URL>/seller/register)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Optional Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
