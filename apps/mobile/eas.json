{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4000", "EXPO_PUBLIC_WEB_URL": "http://10.0.2.2:3000" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://stylekart-api.onrender.com", "EXPO_PUBLIC_WEB_URL": "https://REPLACE-WITH-YOUR-WEBSITE" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://stylekart-api.onrender.com", "EXPO_PUBLIC_WEB_URL": "https://REPLACE-WITH-YOUR-WEBSITE" }
    }
  },
  "submit": {
    "production": {}
  }
}
