# Copy to .env — Expo inlines EXPO_PUBLIC_* values into the app at build time.
# Your backend API (Render). Android emulator: http://10.0.2.2:4000, real phone: http://<your-PC-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Customer website (policy pages, password reset)
EXPO_PUBLIC_WEB_URL=http://localhost:3000
EXPO_PUBLIC_STORE_NAME=DukaanX
